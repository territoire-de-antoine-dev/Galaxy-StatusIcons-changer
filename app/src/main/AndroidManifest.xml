<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="com.android.systemui"/></queries>
    <application android:label="Galaxy Status Bar Studio" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <meta-data android:name="xposedmodule" android:value="true"/>
        <meta-data android:name="xposedminversion" android:value="93"/>
        <meta-data android:name="xposeddescription" android:value="Icônes personnelles pour la barre d’état Samsung"/>
        <meta-data android:name="xposedscope" android:resource="@array/scope"/>
        <provider android:name=".PublishedPack" android:authorities="studio.galaxy.statusbar.packs" android:directBootAware="true" android:exported="true"/>
        <activity android:name=".Studio" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
    </application>
</manifest>
